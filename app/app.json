{
  "expo": {
    "name": "TurnoSmart",
    "slug": "turnosmart-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.turnosmart.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f2f2f3"
      },
      "package": "com.turnosmart.app"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f2f2f3"
        }
      ],
      "expo-asset"
    ]
  }
}
