{
  "expo": {
    "name": "TurnoSmart",
    "slug": "turnosmart-app",
    "owner": "lauescobar",
    "scheme": "turnosmart",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.turnosmart.app"
    },
    "android": {
      "package": "com.lauraescobar.turnosmart",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0250A9"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#0250A9",
          "defaultChannel": "cupos-y-citas"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0250A9"
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "TurnoSmart usa tus fotos solo para que elijas tu foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TurnoSmart usa Face ID para que ingreses sin escribir tu contraseña."
        }
      ],
      "expo-status-bar"
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "4968630f-3d1d-4202-81f4-3eacb632fbe5"
      }
    }
  }
}
